# bash completion for git-repos

_git_repos_completions() {
  local cur prev opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  opts="--help --list --fetch --pull"

  case "$prev" in
    --help | --list | --fetch | --pull)
      return 0
      ;;
  esac

  COMPREPLY=($(compgen -W "$opts" -- "$cur"))
  return 0
}

complete -F _git_repos_completions git-repos

_git_repos() {
  _git_repos_completions
}
