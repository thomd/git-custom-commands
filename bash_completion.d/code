_CODE_OPTIONS="--profile --add-mcp --install-extension --uninstall-extension --list-extensions --update-extensions"

_code_profile_storage_path() {
  printf '%s' "$HOME/Library/Application Support/Code/User/globalStorage/storage.json"
}

_code_profile_names() {
  local storage
  storage="$(_code_profile_storage_path)"
  [[ -r "$storage" ]] || return 0

  jq -r '.userDataProfiles[]? | select((.location // "") | contains("builtin") | not) | .name // empty' "$storage" 2>/dev/null
}

_code_completions() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  case "$prev" in
    --profile)
      local IFS=$'\n'
      COMPREPLY=($(compgen -W "$(_code_profile_names)" -- "$cur"))
      return 0
      ;;
  esac

  COMPREPLY=($(compgen -W "$_CODE_OPTIONS" -- "$cur"))
}

complete -o default -F _code_completions code
